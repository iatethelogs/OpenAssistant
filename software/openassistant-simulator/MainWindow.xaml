<Window x:Class="OpenAssistant.Simulator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenAssistant Simulator" Width="950" Height="710" MinWidth="740" MinHeight="560" Background="#10151F" Foreground="#E9EFFA">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#6F97F0"/><Setter Property="Foreground" Value="#0B1425"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#1C2533"/><Setter Property="Foreground" Value="#EFF3FC"/><Setter Property="BorderBrush" Value="#39485F"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/></Style>
</Window.Resources>
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="OPENASSISTANT / SIMULATOR" FontWeight="Bold" FontSize="25" Foreground="#A4BEFF"/><TextBlock Text="Эмулятор голосовой колонки · Windows" Foreground="#99A9C2" Margin="0,5,0,18"/></StackPanel>
<Border Grid.Row="1" Background="#1B2431" CornerRadius="12" Padding="16" Margin="0,0,0,18"><StackPanel>
<TextBlock Text="Адрес сервера WebSocket"/><TextBox x:Name="ServerAddress" Text="ws://127.0.0.1:5055/ws" Margin="0,7,0,10"/>
<TextBlock Text="Ключ устройства (для подключения по сети)"/><TextBox x:Name="DeviceToken" Margin="0,7,0,10"/>
<WrapPanel><Button x:Name="ConnectButton" Content="Подключиться" Click="Connect_Click"/><Button Content="Отключиться" Click="Disconnect_Click"/><Button x:Name="TalkButton" Content="Говорить" Click="Talk_Click"/><Button Content="Закончить фразу" Click="End_Click"/><Button Content="Прервать" Click="Cancel_Click"/></WrapPanel>
<TextBlock x:Name="StateText" Text="Не подключено" Foreground="#B5C8EC" Margin="0,12,0,0"/>
</StackPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#1B2431" CornerRadius="12" Padding="16" Margin="0,0,9,0"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Голосовая активация" FontSize="17" FontWeight="SemiBold"/>
<TextBlock Text="Детектор запускается отдельным локальным процессом." Foreground="#9DADC3" TextWrapping="Wrap" Margin="0,7,0,10"/>
<TextBlock Text="Команда детектора (exe)" /><TextBox x:Name="DetectorExecutable" Margin="0,6,0,8"/>
<TextBlock Text="Аргументы детектора"/><TextBox x:Name="DetectorArguments" Margin="0,6,0,8"/>
<CheckBox x:Name="WakeEnabled" Content="Автоматически начинать фразу после кодового слова" Margin="0,8,0,10"/>
<TextBlock Text="Текстовый запрос"/><DockPanel Margin="0,6,0,10"><Button DockPanel.Dock="Right" Content="Отправить" Click="Text_Click" Margin="8,0,0,0"/><TextBox x:Name="RequestText" KeyDown="RequestText_KeyDown"/></DockPanel>
<TextBlock Text="Последнее распознавание" Foreground="#9DADC3"/></StackPanel>
<TextBlock x:Name="TranscriptText" Text="—" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#EFF3FC"/>
</DockPanel></Border>
<Border Grid.Column="1" Background="#1B2431" CornerRadius="12" Padding="16" Margin="9,0,0,0"><DockPanel>
<TextBlock Text="События и пакеты" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,9"/>
<TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111924" BorderThickness="0"/>
</DockPanel></Border>
</Grid>
<Border Grid.Row="3" Background="#1B2431" CornerRadius="12" Padding="14" Margin="0,18,0,0"><DockPanel>
<Button Content="Остановить музыку" DockPanel.Dock="Right" Click="StopMusic_Click"/>
<TextBlock x:Name="MusicText" Text="Плеер: ожидание" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
</DockPanel></Border>
</Grid></Window>