<Window x:Class="OpenAssistant.Simulator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:display="clr-namespace:OpenAssistant.Simulator.Display"
 Title="OpenAssistant · Эмулятор колонки" Width="1060" Height="820"
 MinWidth="810" MinHeight="630" Background="#17191D" Foreground="#ECEEF1"
 FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
 <Window.Resources>
   <SolidColorBrush x:Key="Surface" Color="#22252A"/>
   <SolidColorBrush x:Key="Line" Color="#393D44"/>
   <SolidColorBrush x:Key="Secondary" Color="#A8AFBC"/>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECEEF1"/></Style>
   <Style TargetType="Button">
     <Setter Property="Background" Value="#333940"/>
     <Setter Property="Foreground" Value="#E8EBF2"/>
     <Setter Property="BorderBrush" Value="#4A5059"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="Padding" Value="13,7"/>
     <Setter Property="Margin" Value="0,0,8,0"/>
     <Setter Property="MinHeight" Value="32"/>
     <Setter Property="Cursor" Value="Hand"/>
   </Style>
   <Style TargetType="TextBox">
     <Setter Property="Background" Value="#191C21"/>
     <Setter Property="Foreground" Value="#EFF1F5"/>
     <Setter Property="CaretBrush" Value="#DFE7F9"/>
     <Setter Property="BorderBrush" Value="#434A54"/>
     <Setter Property="Padding" Value="9,6"/>
     <Setter Property="MinHeight" Value="33"/>
   </Style>
   <Style TargetType="CheckBox">
     <Setter Property="Foreground" Value="#C9CDD6"/>
     <Setter Property="Margin" Value="0,7,0,0"/>
     <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="FieldLabel" TargetType="TextBlock">
     <Setter Property="Foreground" Value="#A8AFBC"/>
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="Margin" Value="0,8,0,5"/>
   </Style>
 </Window.Resources>
 <Grid Margin="18">
   <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="224"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="2,0,2,15">
     <TextBlock Text="OpenAssistant" FontSize="19" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
     <TextBlock Text="Эмулятор колонки · Windows" Foreground="{StaticResource Secondary}"
                Margin="14,0,0,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="StateText" Text="Не подключено" FontSize="12"
                Foreground="#B9C5D6" TextAlignment="Right" VerticalAlignment="Center"/>
   </DockPanel>

   <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="11"
           BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
     <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="192"/></Grid.ColumnDefinitions>
       <display:RgbMatrixView x:Name="Matrix" Grid.Column="0" Margin="0,0,12,0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
       <StackPanel Grid.Column="1" Margin="10,6,0,0">
         <TextBlock x:Name="MatrixDimensionsText" Text="32 × 10 · 320 RGB" FontWeight="SemiBold" FontSize="14"/>
         <TextBlock x:Name="MatrixModeText" Text="Отключено" Foreground="{StaticResource Secondary}" Margin="0,8,0,0"/>
         <TextBlock x:Name="MicLevelText" Text="Микрофон: —" Foreground="{StaticResource Secondary}" Margin="0,8,0,15"/>
         <Button Content="Загрузить RGB888" Click="BrowseRgb_Click"/>
         <Button Content="Сбросить анимацию" Click="ClearRgb_Click" Margin="0,7,8,0"/>
         <Button Content="Обновить настройки" Click="ReloadDisplay_Click" Margin="0,7,8,0"/>
       </StackPanel>
     </Grid>
   </Border>

   <Grid Grid.Row="2" Margin="0,14,0,10">
     <Grid.ColumnDefinitions>
       <ColumnDefinition Width="0.92*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.08*"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
             BorderThickness="1" CornerRadius="10" Padding="15">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
           <TextBlock Text="Подключение" FontWeight="SemiBold" FontSize="14"/>
           <TextBlock Text="Сервер OpenAssistant" Style="{StaticResource FieldLabel}"/>
           <TextBox x:Name="ServerAddress" Text="ws://127.0.0.1:5055/ws" IsReadOnly="True"/>
           <WrapPanel Margin="0,8,0,0">
             <Button x:Name="FindServerButton" Content="Найти и подключиться" Click="FindServer_Click"/>
             <TextBlock x:Name="DiscoverStatus" Text="UDP-поиск по локальной сети"
                        VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Secondary}"
                        FontSize="11"/>
           </WrapPanel>
           <TextBlock Text="Ключ устройства (для LAN не требуется)" Style="{StaticResource FieldLabel}"/>
           <PasswordBox x:Name="DeviceToken" Background="#191C21" Foreground="#EFF1F5"
                        BorderBrush="#434A54" Padding="9,6" MinHeight="33"/>
           <TextBlock Text="Профиль собеседника" Style="{StaticResource FieldLabel}"/>
           <TextBox x:Name="ProfileName" Text="Общий"/>
           <WrapPanel Margin="0,13,0,0">
             <Button x:Name="ConnectButton" Content="Подключиться" Click="Connect_Click"/>
             <Button Content="Отключиться" Click="Disconnect_Click"/>
           </WrapPanel>
           <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,13,0,0">
             <StackPanel>
               <TextBlock Text="Микрофон и обработка звука" FontSize="13" FontWeight="SemiBold"/>
               <CheckBox x:Name="CommunicationsEnabled" IsChecked="True"
                         Content="Режим Windows Communications (AEC, NS, AGC)"/>
               <CheckBox x:Name="NoiseSuppressionEnabled" IsChecked="True"
                         Content="Программное подавление фонового шума"/>
               <TextBlock x:Name="CaptureModeText" Foreground="{StaticResource Secondary}"
                          FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
             </StackPanel>
           </Border>
           <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                   Margin="0,15,0,0" Padding="0,13,0,0">
             <StackPanel>
               <TextBlock Text="Слово активации" FontSize="13" FontWeight="SemiBold"/>
               <CheckBox x:Name="WakeEnabled" Content="Распознавать локально (C# / TensorFlow Lite)" IsChecked="True"/>
               <TextBlock Text="Модель WakeForge · .tflite или .json" Style="{StaticResource FieldLabel}"/>
               <DockPanel>
                 <Button Content="…" DockPanel.Dock="Right" Width="36" Click="BrowseWakeModel_Click" Margin="7,0,0,0"/>
                 <TextBox x:Name="WakeModelPath"/>
               </DockPanel>
               <Grid Margin="0,9,0,0">
                 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                 <StackPanel><TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WakeName" Text="Мартин"/></StackPanel>
                 <StackPanel Grid.Column="2"><TextBlock Text="Порог" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WakeThreshold" Text="0.87"/></StackPanel>
               </Grid>
               <CheckBox x:Name="BargeInOnMusic" Content="Разрешать активацию во время музыки"/>
               
             </StackPanel>
           </Border>
           <Button Content="Сохранить параметры" Click="SavePreferences_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
         </StackPanel>
       </ScrollViewer>
     </Border>

     <Border Grid.Column="2" Background="{StaticResource Surface}"
             BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15">
       <Grid>
         <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
           <RowDefinition Height="*"/>
         </Grid.RowDefinitions>
         <StackPanel Grid.Row="0">
           <TextBlock Text="Диалог" FontSize="14" FontWeight="SemiBold"/>
           <WrapPanel Margin="0,12,0,10">
             <Button x:Name="TalkButton" Content="Записать без wake-word" ToolTip="Начать запись напрямую, без отправки слова активации" Click="Talk_Click"/><Button x:Name="SimulateWakeButton" Content="Имитировать «Мартин»" ToolTip="То же событие, что срабатывание детектора: wake → запись команды → сервер" Click="SimulateWake_Click"/>
             <Button Content="Завершить фразу" Click="End_Click"/>
             <Button Content="Отмена" Click="Cancel_Click"/>
           </WrapPanel>
<TextBlock Text="Обе кнопки записывают голос до паузы. Имитация дополнительно отправляет wake-событие на сервер." Foreground="{StaticResource Secondary}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,5"/>
           <TextBlock Text="Текстовый запрос" Style="{StaticResource FieldLabel}"/>
           <DockPanel>
             <Button Content="Отправить" DockPanel.Dock="Right" Click="Text_Click" Margin="8,0,0,0"/>
             <TextBox x:Name="RequestText" KeyDown="RequestText_KeyDown"/>
           </DockPanel>
         </StackPanel>
         <StackPanel Grid.Row="1" Margin="0,12,0,0">
           <TextBlock Text="Распознано" Foreground="{StaticResource Secondary}" FontSize="11"/>
           <TextBlock x:Name="TranscriptText" Text="—" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="86"/>
         </StackPanel>
         <StackPanel Grid.Row="2" Margin="0,12,0,0">
           <TextBlock Text="Ответ" Foreground="{StaticResource Secondary}" FontSize="11"/>
           <TextBlock x:Name="AnswerText" Text="—" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="120"/>
         </StackPanel>
         <TextBlock Grid.Row="3" Text="Журнал" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,7"/>
         <TextBox Grid.Row="4" x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto" Background="#191C21"
                  BorderThickness="1" BorderBrush="#343943" Padding="9"
                  FontFamily="Consolas" FontSize="10" MinHeight="85"/>
       </Grid>
     </Border>
   </Grid>

   <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
           BorderThickness="1" CornerRadius="9" Padding="11,10">
     <DockPanel>
       <Button Content="Остановить музыку" DockPanel.Dock="Right" Click="StopMusic_Click" Margin="10,0,0,0"/>
       <TextBlock x:Name="MusicText" Text="Музыка не воспроизводится" VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"/>
     </DockPanel>
   </Border>
 </Grid>
</Window>
