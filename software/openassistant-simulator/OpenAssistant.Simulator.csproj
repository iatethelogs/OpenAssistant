<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
<UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
</PropertyGroup>
<ItemGroup><PackageReference Include="NAudio" Version="3.3.0"/></ItemGroup>
<ItemGroup Condition="Exists('WakeDetector/target/release/openassistant-wake.exe')">
  <Content Include="WakeDetector/target/release/openassistant-wake.exe"
           Link="openassistant-wake.exe" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup><Using Include="System.IO" /></ItemGroup>
</Project>